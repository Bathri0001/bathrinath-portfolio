# Site URL (optional, used for canonical / Open Graph / sitemap)
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Contact form email - choose ONE option
# Option A (easiest): Resend. Sign up at resend.com with bathri2404@gmail.com and create an API key
RESEND_API_KEY=
# Option B: Gmail SMTP with a Google "App password"
SMTP_USER=
SMTP_PASS=
# Where messages are delivered (defaults to bathri2404@gmail.com)
CONTACT_TO=bathri2404@gmail.com

# Shared visitor + like counters (Upstash Redis, free).
# Added automatically when you connect Upstash Redis in the Vercel dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
